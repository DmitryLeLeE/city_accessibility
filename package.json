{
  "name": "city-accessibility",
  "version": "1.1.0",
  "description": "Пешая доступность городской инфраструктуры: изохроны, районы, проблемные зоны (OpenStreetMap)",
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "start": "python3 -m http.server 8080",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "test:e2e": "node tests/e2e/run.mjs",
    "lint": "eslint .",
    "test:all": "npm test && npm run test:e2e",
    "screenshots": "node tests/e2e/screenshots.mjs",
    "og": "node tests/e2e/og.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "leaflet": "^1.9.4",
    "osmtogeojson": "^3.0.0-beta.5",
    "playwright": "1.64"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "author": {
    "name": "Dmitry Papilin",
    "url": "https://github.com/DmitryLeLeE"
  },
  "homepage": "https://github.com/DmitryLeLeE/city_accessibility",
  "build": {
    "appId": "io.github.dmitryleleE.cityaccessibility",
    "productName": "City Accessibility",
    "artifactName": "CityAccessibility-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "index.html",
      "css/**",
      "js/**",
      "vendor/**",
      "img/**",
      "LICENSE",
      "package.json"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1049",
      "artifactName": "CityAccessibility-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "CityAccessibility-Portable-${version}.exe"
    }
  }
}
